    "GermanyDummyWarningsApiComponent": {
      "countries": [
        "DE"
      ],
      "capability": "OfficialWeatherWarnings",
      "hazards": [
        "wind"
      ],
      "display_name": "Niemcy \u2014 \u017ar\u00f3d\u0142o testowe",
      "description": "Dane syntetyczne. Nie s\u0105 ostrze\u017ceniami urz\u0119dowymi i nie steruj\u0105 domem.",
      "parameter_schema": {
        "additionalProperties": false,
        "description": "Select a synthetic region and a repeatable preview scenario.",
        "properties": {
          "region_code": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Identyfikator testowy, bez znaczenia urz\u0119dowego.",
            "title": "Region testowy"
          },
          "scenario": {
            "default": "empty",
            "description": "Wy\u0142\u0105cznie syntetyczny podgl\u0105d, bez wp\u0142ywu na bezpiecze\u0144stwo domu.",
            "enum": [
              "empty",
              "warning",
              "unavailable",
              "stale"
            ],
            "title": "Scenariusz testowy",
            "type": "string"
          }
        },
        "title": "GermanyDummyParameters",
        "type": "object"
      },
      "required_when_selected": [
        "region_code"
      ],
      "parameter_defaults": {
        "scenario": "empty"
      },
      "data_kind": "synthetic",
      "transport_kind": "none"
    },
