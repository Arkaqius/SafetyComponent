# Konfiguracja aplikacji (wartości VITE_* są publiczne w bundle).
VITE_FOLDER_NAME=SafetyHome
VITE_HA_URL=http://homeassistant.local:8123

# Token wyłącznie do lokalnego `npm run sync`; nie używaj prefiksu VITE_.
HA_SYNC_TOKEN=

# Deploy przez SSH/SFTP. Preferowany jest klucz prywatny.
HA_SSH_HOSTNAME=homeassistant.local
HA_SSH_PORT=22
HA_SSH_USERNAME=root
HA_SSH_PRIVATE_KEY_PATH=
HA_SSH_KEY_PASSPHRASE=

# Alternatywa dla klucza prywatnego.
HA_SSH_PASSWORD=

# Zweryfikowany odcisk klucza hosta w standardowym formacie OpenSSH.
HA_SSH_HOST_FINGERPRINT=SHA256:
