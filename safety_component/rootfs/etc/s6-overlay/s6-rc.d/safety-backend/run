#!/command/with-contenv bashio
# shellcheck shell=bash

readonly user_config="/config/user_config.yml"
readonly runtime_apps="/run/safety-component/apps"
readonly core_location="/run/safety-component/ha-location.json"

if [[ ! -f "${user_config}" ]]; then
    bashio::log.warning \
        "No user_config.yml yet; open Safety Home → Konfiguracja to create it, then restart this App"
    exec sleep 2147483647
fi

log_level="$(bashio::config 'log_level' | tr '[:lower:]' '[:upper:]')"
declare core_state=""
declare -i waited=0

while [[ ${waited} -lt 300 ]]; do
    core_state=$(curl -s -m 10 \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        "http://supervisor/core/api/config" \
        | jq -r '(.state // empty) | ascii_downcase' 2>/dev/null) \
        || core_state=""

    if [[ "${core_state}" = "running" ]]; then
        break
    fi

    if [[ ${waited} -eq 0 ]]; then
        bashio::log.info "Waiting for Home Assistant to finish starting..."
    fi
    sleep 5
    waited=$((waited + 5))
done

if [[ "${core_state}" != "running" ]]; then
    bashio::log.warning \
        "Home Assistant is not running after ${waited}s; starting AppDaemon anyway"
fi

if ! python /opt/safety-component/backend/build_appdaemon_config.py \
    --template /etc/safety-component/appdaemon.yaml \
    --location-output "${core_location}" \
    --output /data/appdaemon/appdaemon.yaml; then
    bashio::log.error \
        "Could not build AppDaemon configuration; Safety Home remains available"
    exec sleep 2147483647
fi

if ! python /opt/safety-component/backend/build_app_config.py \
    --system /opt/safety-component/backend/config/system_config.yml \
    --user "${user_config}" \
    --home-assistant-config "${core_location}" \
    --log-level "${log_level}" \
    --output "${runtime_apps}/apps.yaml"; then
    bashio::log.error \
        "Configuration compilation failed; edit user_config.yml in Safety Home and restart this App"
    exec sleep 2147483647
fi

bashio::log.info "Starting the SafetyFunctions AppDaemon runtime"
exec appdaemon -c /data/appdaemon -D "${log_level}"
