#!/command/with-contenv bashio
# shellcheck shell=bash

readonly container_exit_code="$(</run/s6-linux-init-container-results/exitcode)"
readonly service_exit_code="${1}"
readonly service_signal="${2}"

bashio::log.info \
    "SafetyFunctions runtime exited with code ${service_exit_code}" \
    "(signal ${service_signal})"

if [[ "${service_exit_code}" -eq 256 ]]; then
    if [[ "${container_exit_code}" -eq 0 ]]; then
        echo $((128 + service_signal)) > /run/s6-linux-init-container-results/exitcode
    fi
    [[ "${service_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${service_exit_code}" -ne 0 ]]; then
    if [[ "${container_exit_code}" -eq 0 ]]; then
        echo "${service_exit_code}" > /run/s6-linux-init-container-results/exitcode
    fi
    exec /run/s6/basedir/bin/halt
fi
