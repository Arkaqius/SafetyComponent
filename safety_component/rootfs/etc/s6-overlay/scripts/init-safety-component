#!/command/with-contenv bashio
# shellcheck shell=bash

set -euo pipefail

readonly runtime_root="/run/safety-component"
readonly runtime_apps="${runtime_root}/apps"

mkdir -p "/config/appdaemon" "${runtime_apps}" "/data/appdaemon"

cp /opt/safety-component/backend/SafetyFunctions.py "${runtime_apps}/SafetyFunctions.py"
cp -R /opt/safety-component/backend/components "${runtime_apps}/components"

bashio::log.info "SafetyComponent frontend and configuration API initialized"
